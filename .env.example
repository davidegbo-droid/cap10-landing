# App
NODE_ENV=development
APP_NAME=Capital10
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000

# Database (MySQL)
DATABASE_URL=mysql://root:password@localhost:3306/capital10
DB_POOL_MIN=2
DB_POOL_MAX=20

# Auth
COOKIE_NAME=capital10_session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=30
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_secret

# CORS
CORS_ORIGIN=http://localhost:5173

# AI Assistant (template customization only)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Feature Flags
FEATURE_MATCHING=true
FEATURE_AI_TEMPLATE_ASSIST=true
FEATURE_ADVANCED_ANALYTICS=false
